GROQ_API_KEY=your_groq_api_key_here

# Optional second Groq key. On 429, the rate limiter switches between the two.
# GROQ_API_KEY_2=your_second_groq_api_key_here

# Fall back to Ollama when both Groq keys hit the daily limit.
# Requires OLLAMA_URL to be reachable.
# GROQ_FALLBACK_TO_OLLAMA=false

# Optional: HTTP proxy settings
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
